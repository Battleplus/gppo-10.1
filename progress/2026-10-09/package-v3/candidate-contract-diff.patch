+    spy = NoForwardTarget()
+    with handshake(output, request) as server:
+        ledger = BudgetLedger(output / 'ledger.sqlite', request)
+        driver = Driver(workspace, output, matrix, ledger, Factory())
+        driver.phase('input_admission')
+        reuse = os.environ.get('W1_CANDIDATE_CONTROLLED_CACHE')
+        if reuse:
+            import gzip
+            previous = Path(reuse)
+            require(json.loads((previous.parent/'RESOURCE_REQUEST.json').read_text())['approval_status'] == 'ENGINEERING_ONLY')
+            inventory_source = json.loads((previous/'source-inventory.json').read_text())['windows']
+            lean = []
