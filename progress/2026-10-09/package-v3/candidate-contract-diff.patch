+class Fixture(Environment):
+    def _observation(self):
+        self.public_read_count = getattr(self, 'public_read_count', 0) + 1
+        state = super()._observation()
+        state['mask'][:24] = False
+        if self.clock.time < self.horizon and not self.noop:
+            for u in range(4):
+                t = (u + int(self.clock.time)) % self.n
+                state['mask'][u * 6 + t] = True
+        state['graph']['relations'][:, :, 2] = state['mask'][:24].reshape(4, 6)
+        state['flat'][-98:-2] = state['graph']['relations'].reshape(-1)
+        # Match the production bridge's observable private-state mutation without native environments.
+        self.issued_observation = {'read': self.public_read_count, 'time': self.clock.time}
+        return state
+
+
+class Factory:
+    def __call__(self, spec, config, purpose):
+        return Fixture(spec, config, purpose)
+
+
+class NoForwardTarget:
+    calls = 0
+    def target(self, nodes):
+        self.calls += 1
+        raise AssertionError('NEURAL_TARGET_FORWARD_FORBIDDEN')
+
+
+def case(name, function):
+    started = time.monotonic()
+    function()
+    CASES.append({'name': name, 'pass': True, 'wall_seconds': time.monotonic() - started})
+    print('PASS ' + name, flush=True)
+
+
+def rejects(function, names=None):
+    try:
+        function()
+    except (ValueError, BudgetError) as exc:
+        if names is not None and str(exc).split(':')[0] not in names:
+            raise AssertionError('Unexpected rejection: ' + str(exc)) from exc
+        return str(exc)
+    raise AssertionError('Invalid candidate was not rejected')
+
+
+@contextmanager
+def handshake(output, request):
+    own = resource.getrusage(resource.RUSAGE_SELF)
+    children = resource.getrusage(resource.RUSAGE_CHILDREN)
+    server = StageServer(output / 'phase.sock', request, tree_reader=proc_tree,
+        cpu_origin_seconds=own.ru_utime + own.ru_stime + children.ru_utime + children.ru_stime,
+        wall_origin_monotonic=START)
+    old = os.environ.get('W1_PHASE_ACCOUNTING_SOCKET')
+    os.environ['W1_PHASE_ACCOUNTING_SOCKET'] = str(server.path)
+    stop = threading.Event(); errors = []
+    def serve():
+        while not stop.is_set():
+            try: server.process_pending(os.getpid())
+            except BaseException as exc: errors.append(repr(exc))
+            stop.wait(.001)
+    thread = threading.Thread(target=serve); thread.start()
+    try:
+        yield server
+    finally:
+        stop.set(); thread.join(timeout=6)
+        assert not thread.is_alive()
+        server.close()
+        if old is None: os.environ.pop('W1_PHASE_ACCOUNTING_SOCKET', None)
+        else: os.environ['W1_PHASE_ACCOUNTING_SOCKET'] = old
+        durable_atomic_json(output / 'handshake-result.json', {'errors': errors, 'rows': server.rows})
+        assert not errors
+
+
+def setup():
