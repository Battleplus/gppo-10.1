+            'same_action_wrong_parent': lambda r: r['branches'][0]['candidate_key'].__setitem__('parent', 'other-parent'),
+            'same_action_wrong_window': lambda r: r['branches'][0]['candidate_key'].__setitem__('window_id', 'time-99'),
+            'illegal_action': lambda r: r['branches'][0]['candidate_key'].__setitem__('action_index', 25),
+            'wrong_uav_slot': lambda r: r['branches'][0]['candidate_key'].__setitem__('uav_slot', 3),
+            'wrong_task_slot': lambda r: r['branches'][0]['candidate_key'].__setitem__('task_slot', 5),
+            'candidate_key_list_instead_of_object': lambda r: r['branches'][0].__setitem__('candidate_key', list(r['branches'][0]['candidate_key'].values())),
