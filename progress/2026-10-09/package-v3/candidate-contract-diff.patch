+def require(value):
+    if not value: raise AssertionError('Required condition failed')
+
+
+def check_windows(lean):
+    require(len(lean) == 12)
+    require({r['state_before']['time'] for r in lean} == {2., 4., 8., 12.})
+    require({len(r['state_before']['public_entity_ids']['tasks']) for r in lean} == {3, 4, 6})
+    require(all(any(k['noop'] for k in r['candidate_keys']) for r in lean))
+    require({k['uav_slot'] for r in lean for k in r['candidate_keys'] if not k['noop']} == {0, 1, 2, 3})
+    require({k['task_slot'] for r in lean for k in r['candidate_keys'] if not k['noop']} == set(range(6)))
+
+
+def check_layers(driver, row, parts):
+    validate_catalog(row['candidate_keys'], row['candidate_context'], row['state_before'])
+    predictions = [serialize_prediction(k, row['candidate_context'], row['state_before'], task_slots(row['state_before']),
+                    [0.] * READOUT_DIM, [False] * READOUT_DIM) for k in row['candidate_keys']]
+    require([p['candidate_key_sha256'] for p in predictions] == [key_digest(k) for k in row['candidate_keys']])
+    require(row['candidate_audits']['collector']['candidate_sequence_sha256'] == parts[-1]['audit']['candidate_sequence_sha256'])
+    require(all(l['candidate_key'] == k for l, k in zip(row['labels'], row['candidate_keys'])))
+    require([k['action_index'] for k in row['candidate_keys']] == parts[2].tolist())
+
+
+def check_unknown(parts):
+    masks = parts[5]
+    require(not masks['binary'][:, 4].any())
+    require(not masks['per_task'][:, 3:].any())
+    noop = int(torch.where(parts[2] == 24)[0][0])
+    require(not masks['binary'][noop, :3].any())
+
+
+def make_replay(driver, row):
+    state, context, keys = row['state_before'], row['candidate_context'], row['candidate_keys']
+    base, aux, valid, mask, available, trace = driver.features(state, 'T', candidate_context=context, candidate_keys=keys)
+    pack_context = SimpleNamespace(arm='T', normalization_mean=torch.zeros(AUX_DIM), normalization_scale=torch.ones(AUX_DIM))
+    packed = ConsequencePolicy.pack(pack_context, base, aux, valid, mask, available).numpy()
+    return {'candidate_features': packed, 'mask': mask.numpy(), 'action': keys[0]['action_index'],
+            'replay_evidence': {'candidate_state_before': state, 'candidate_context': context, 'candidate_keys': keys,
+                'candidate_feature_binding': feature_binding(keys, context, state, packed),
+                'candidate_audits': dict(trace['candidate_audits'], replay=audit('replay', keys, context, state)),
+                'counterfactual_identity': {'public_sha256': context['public_sha256'], 'feature_contract': FEATURE_ID}}}
+
+
+def check_update_entries():
+    source = (ROOT / 'package/native/gppo_world/joint_training.py').read_text()
+    tree = ast.parse(source)
+    for name in ('ppo_preference_update', 'ppo_weighted_preference_update'):
+        functions = [x for x in tree.body if isinstance(x, ast.FunctionDef) and x.name == name]
+        if not functions:
+            raise AssertionError('Native update entry missing')
+        body = functions[0].body
+        block = body[1] if isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and type(body[0].value.value) is str else body[0]
+        require(isinstance(block, ast.If))
+        require(any(isinstance(x, ast.Call) and isinstance(x.func, ast.Name) and x.func.id == 'verify_update' for x in ast.walk(block)))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except BaseException as exc:
+        import traceback
+        path = DIAG / 'acceptance-first-error.json'
+        if not path.exists(): durable_atomic_json(path, {'type': type(exc).__name__, 'message': str(exc), 'traceback': traceback.format_exc(), 'completed_tests': CASES})
+        raise
